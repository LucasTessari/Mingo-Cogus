NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
DATABASE_URL=postgresql://mingo:mingo@127.0.0.1:5433/mingo?schema=public
TEST_DATABASE_URL=postgresql://mingo:mingo@127.0.0.1:5433/mingo_test?schema=public
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Origem do site (o proxy do Vite deixa front e API na mesma origem em dev)
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Só em produção com front e API em domínios diferentes (lista separada por vírgula)
CORS_ORIGINS=
RATE_LIMIT_ENABLED=true
# approve | decline | pending
PAYMENT_SIMULATOR_OUTCOME=approve
# Memória do argon2id em KiB (mínimo recomendado pela OWASP: 19456)
ARGON2_MEMORY_KIB=19456
# Usados apenas por `npm run db:seed` e `npm run admin:create`
ADMIN_EMAIL=admin@mingocogus.test
ADMIN_NAME=Administrador
ADMIN_PASSWORD=
