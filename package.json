{
  "name": "mingo-cogus",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @mingo/api",
    "db:seed": "npm run db:seed -w @mingo/api",
    "db:reset": "npm run db:reset -w @mingo/api",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w @mingo/api\" \"npm run dev -w @mingo/web\"",
    "build": "npm run build -w @mingo/api && npm run build -w @mingo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @mingo/web",
    "test:visual": "npm run test:visual -w @mingo/web",
    "visual:baseline": "npm run capture -w @mingo/visual-baseline",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
